# Settings for the app. On the hotel PC: copy this file to .env and fill it in.
# On Railway: set the same names in the service's "Variables" tab instead
# (Railway provides DATABASE_URL and PORT itself).

# --- Database (required) ---
# PostgreSQL connection. Railway: reference the Postgres service's DATABASE_URL.
DATABASE_URL=postgresql://arenas_app:password@localhost:5432/arenas
# Hotel's time zone: timestamps, "today", reports and receipts use it.
HOTEL_TIMEZONE=America/Managua

# --- Security (required on Railway) ---
# Flask session secret — set a long random value. This placeholder is
# ignored; without a real one a key is generated per machine (and on
# Railway, per deploy: everyone gets logged out).
SECRET_KEY=dev-secret-key-change-in-production
# Railway only: trust the proxy's visitor-address headers (login limits).
# Never set this on the hotel PC.
# TRUST_PROXY_HEADERS=1

# --- Kitchen/bar printing from the cloud ---
# When set, the server doesn't print by itself: the print agent
# (print_agent.py) on a hotel PC fetches the tickets using this same token.
# Leave unset on the hotel PC, where the app prints directly.
# PRINT_AGENT_TOKEN=a-long-random-secret

# --- Backups ---
# Where backup files go. On Railway point it at a mounted volume (e.g.
# /data/backups), or backups vanish on every deploy.
# BACKUPS_DIR=/data/backups

# How often the automatic report runs, in days.
REPORT_SCHEDULE_DAYS=15

# --- Cloud-synced folder (Google Drive / Dropbox desktop app; hotel PC only) ---
# The app copies each report/backup into this folder and the Drive/Dropbox
# app uploads it, e.g. C:\Users\you\Google Drive\Arenas Beach Reports
# CLOUD_SYNC_FOLDER_PATH=C:\Users\you\Google Drive\Arenas Beach Reports

# --- Email delivery of reports (SMTP) ---
# Example values for Gmail (use an App Password, not your real password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# REPORT_FROM_EMAIL=your-email@gmail.com
# REPORT_TO_EMAIL=owner@example.com
